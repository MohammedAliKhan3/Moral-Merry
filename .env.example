# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.

# Chatbot / AI Hub (Groq by default; any OpenAI-compatible provider works)
GROQ_API_KEY=
# CHAT_API_URL=https://api.groq.com/openai/v1/chat/completions
# CHAT_MODEL=openai/gpt-oss-120b

# Admin panel login (GitHub OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
